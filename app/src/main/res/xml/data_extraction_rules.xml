<?xml version="1.0" encoding="utf-8"?>
<!-- API key 存 DataStore，附件是本地大文件：都不进云备份。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="attachments" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="attachments" />
    </device-transfer>
</data-extraction-rules>
